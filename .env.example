# ---------------------------------------------------------------------------
# HerCare+ environment example
#
# Copy this file to `.env` and fill in ONLY what you actually configure.
#   cp .env.example .env
#
# Honesty rule: every integration here has a safe, clearly-labelled fallback.
# If a value is missing the app keeps working in a demo/console mode and NEVER
# pretends a live provider (SMS, AI) is connected. Do not set production
# credentials you have not verified.
# ---------------------------------------------------------------------------

# --- Server / runtime --------------------------------------------------------
# Node environment. Anything other than "production" is treated as dev.
NODE_ENV=development
# Port the Express API listens on (the Vite dev server proxies /api here).
PORT=8787

# Allowed browser origins for CORS. Comma-separated. Leave empty for
# same-origin only (recommended when using the Vite proxy).
# Example: https://hercare.example.org
CORS_ORIGINS=

# --- OTP policy --------------------------------------------------------------
OTP_TTL_SECONDS=300        # how long a code stays valid (5 min)
OTP_RESEND_SECONDS=30      # cooldown before a new code is minted
OTP_MAX_ATTEMPTS=5         # wrong-entry attempts before the code is locked
OTP_MAX_PER_HOUR=5         # max OTP requests per phone number per hour

# Development mock: return the generated code in the API response so the flow
# can be tested without sending real SMS.
#   *** This is IGNORED (forced OFF) when NODE_ENV=production. ***
#   Never rely on it in production — it would leak codes.
OTP_DEV_MOCK=true

# Secret used by the Vercel serverless API (api/) to sign OTP requestIds and
# session tokens. Set a long random value in your Vercel project settings.
# When unset, a publicly-known dev fallback signs the tokens (demo only).
OTP_TOKEN_SECRET=

# NOTE for Vercel: NODE_ENV is always "production" there (even on previews),
# so the serverless endpoints read VERCEL_ENV instead. The dev mock is ON by
# default on preview URLs and OFF on the production domain unless you set
# OTP_DEV_MOCK=true explicitly (which then reveals every requested code).

# --- SMS provider ------------------------------------------------------------
# One of: console | twilio | msg91
#   console -> default, safe. Logs a redacted preview, delivers NOTHING (simulated).
#   twilio  -> requires all three TWILIO_* values below, else falls back to console.
#   msg91   -> requires MSG91_AUTH_KEY, else falls back to console.
SMS_PROVIDER=console

# Twilio (only used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# MSG91 (only used when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- AI assistant ------------------------------------------------------------
# One of: demo | openai
#   demo   -> default. The endpoint returns { demo: true } and the client uses
#             its own curated, non-diagnostic educational content.
#   openai -> a live model is used ONLY when AI_PROVIDER=openai AND AI_API_KEY
#             AND AI_ENDPOINT are all set. Otherwise the safe demo mode is used.
AI_PROVIDER=demo
AI_API_KEY=
AI_ENDPOINT=
AI_MODEL=gpt-4o-mini

# --- Frontend (Vite) ---------------------------------------------------------
# The browser talks to the API via the relative path /api (proxied by Vite in
# dev), so NO client-side key belongs in this file. Only override the dev proxy
# target here if your API runs somewhere other than localhost:8787.
VITE_API_PROXY_TARGET=http://localhost:8787

# --- Database (Supabase) — future/optional -----------------------------------
# The reference build stores per-user records on-device (localStorage) and OTPs
# in memory. To move to a hosted database, apply server/supabase/schema.sql (it
# includes row-level security) and wire the client to Supabase using:
SUPABASE_URL=
SUPABASE_ANON_KEY=
